NODE_ENV=development
PORT=3000

# TikTok integration
API_KEY=
TIKTOK_AUTO_RECONNECT=true
TIKTOK_MAX_RECONNECT_ATTEMPTS=3
TIKTOK_HEARTBEAT_MS=10000

# Security
JWT_SECRET=replace_with_a_long_random_secret
# Optional but recommended in production. If omitted, JWT_SECRET signs overlay URLs.
OVERLAY_TOKEN_SECRET=replace_with_a_second_long_random_secret

# Database
DATABASE_URL=postgres://postgres:example@localhost:5432/tiktokbr
# PG_CONNECTION_STRING=
# PG_CONN_STRING=

# Redis / Socket.IO scaling
REDIS_URL=redis://localhost:6379
# Whether to enable the Socket.IO Redis adapter in production. Default: false
# Set to 'true' to enable adapter when REDIS_URL is present.
ENABLE_REDIS_ADAPTER=false
# Feature: room-scoped multi-room behavior. Production defaults to true when unset.
# Set to 'false' only if you intentionally want single-room behavior.
ENABLE_ROOM_SCOPED=true

# App URLs
APP_BASE_URL=http://localhost:3000
WRITEFREELY_PUBLIC_URL=http://localhost:8080/
WRITEFREELY_API_URL=http://localhost:8080
WRITEFREELY_COLLECTION_ALIAS=owner
WRITEFREELY_SINGLE_USER=true
# Direct WriteFreely publishing. Prefer API token when available; username/password is supported for local setup.
WRITEFREELY_API_TOKEN=
WRITEFREELY_USERNAME=
WRITEFREELY_PASSWORD=
# Optional legacy bridge if direct API publishing is not used.
WRITEFREELY_POST_WEBHOOK_URL=
WRITEFREELY_POST_WEBHOOK_TOKEN=
WRITEFREELY_MANUAL_POST_DASHBOARD_URL=http://localhost:8080/

# Persistent uploads
DISK_PATH=./data
STORAGE_LIMIT_MB=
STORAGE_MIN_FREE_MB=5

# Reverse proxy / Render
TRUST_PROXY_HOPS=1

# Sponsor media processing
# Optional. When FFmpeg/ffprobe are installed, uploads can be normalized to
# MP4 H.264/AAC 16:9 720p and get server-side thumbnails/metadata.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
SPONSOR_TRANSCODE_ENABLED=true
SPONSOR_STRICT_MEDIA_GATE=true
# SPONSOR_TRANSCODE_PRESET=veryfast
# SPONSOR_TRANSCODE_CRF=23
# SPONSOR_TRANSCODE_TIMEOUT_MS=180000
# SPONSOR_PROBE_TIMEOUT_MS=20000
# SPONSOR_THUMBNAIL_TIMEOUT_MS=30000

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_PAYMENT_LINK=
PAYPAL_CURRENCY=USD

# Google OAuth for login/signup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Email
POSTMARK_API_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
EMAIL_FROM="IntoTheBattle <no-reply@intothebattle.com>"
EMAIL_REPLY_TO=support@intothebattle.com
POSTMARK_TEST_EMAIL=

# Admin-only company growth outbox / marketing automation.
# Generates daily drafts from site pages for company-owned channels. This is not streamer-facing.
# Live publishing requires:
# MARKETING_AUTOMATION_ENABLED=true, MARKETING_DRY_RUN=false, and an authorized webhook.
# The server auto-post scheduler turns on with MARKETING_AUTOMATION_ENABLED unless MARKETING_AUTO_POST_ENABLED=false.
MARKETING_PLATFORMS=tiktok
MARKETING_AUTOMATION_ENABLED=false
MARKETING_AUTO_POST_ENABLED=true
MARKETING_DRY_RUN=true
MARKETING_OUTBOUND_WEBHOOK_URL=
MARKETING_WEBHOOK_X=
MARKETING_WEBHOOK_LINKEDIN=
MARKETING_WEBHOOK_FACEBOOK=
MARKETING_WEBHOOK_INSTAGRAM=
MARKETING_WEBHOOK_TIKTOK=
MARKETING_WEBHOOK_YOUTUBE_SHORTS=
# Maximum admin-uploaded growth creative asset size in MB.
GROWTH_CREATIVE_UPLOAD_MAX_MB=25

# Optional admin/company growth APIs. These sync captured leads and marketing
# events to company-owned tools only; they are not streamer-facing.
GROWTH_TRACKING_ENABLED=false
GROWTH_API_SYNC_ENABLED=false
HUBSPOT_PRIVATE_APP_TOKEN=
# Optional HubSpot custom contact property internal names.
HUBSPOT_SOURCE_PROPERTY=
HUBSPOT_LAST_PATH_PROPERTY=
HUBSPOT_TIKTOK_PROPERTY=
SEGMENT_WRITE_KEY=
SEGMENT_BROWSER_WRITE_KEY=

# Admin
ADMIN_PASSWORD=

# Observability
SENTRY_DSN=
LOG_LEVEL=info
SUPPORT_EMAIL=support@intothebattle.com
INCIDENT_RUNBOOK_URL=
OPERATIONS_ALERT_EMAIL=
ALERT_WEBHOOK_URL=
BACKUP_RESTORE_VERIFIED_AT=
BACKUP_RESTORE_MAX_AGE_DAYS=30
# Microsoft Clarity project id. Leave empty to disable Clarity.
CLARITY_PROJECT_ID=
# Optional. In production, /metrics returns 404 unless this is set.
# Use Authorization: Bearer <token> or x-metrics-token. Query-string tokens are intentionally unsupported in production.
METRICS_TOKEN=replace_with_a_metrics_scrape_token
# Required for production launch readiness. Runtime diagnostics can fall back to METRICS_TOKEN, but launch checks should use a separate token.
# Use Authorization: Bearer <token> or x-diagnostics-token.
DIAGNOSTICS_TOKEN=

# Dev/test
DEV_TEST_MODE=false
