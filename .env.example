NODE_ENV=development
PORT=3000

# TikTok integration
API_KEY=

# Security
JWT_SECRET=replace_with_a_long_random_secret

# Database
DATABASE_URL=postgres://postgres:example@localhost:5432/tiktokbr
# PG_CONNECTION_STRING=
# PG_CONN_STRING=

# Redis / Socket.IO scaling
REDIS_URL=redis://localhost:6379
# Whether to enable the Socket.IO Redis adapter in production. Default: false
# Set to 'true' to enable adapter when REDIS_URL is present.
ENABLE_REDIS_ADAPTER=false
# Feature: room-scoped multi-room behavior. When false, all overlays use the default single room.
ENABLE_ROOM_SCOPED=false

# App URLs
APP_BASE_URL=http://localhost:3000

# Persistent uploads
DISK_PATH=./data

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PAYMENT_LINK=

# Google OAuth for login/signup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Email
POSTMARK_API_TOKEN=
EMAIL_FROM="Battle Royale <no-reply@example.com>"
POSTMARK_TEST_EMAIL=

# Admin
ADMIN_PASSWORD=

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Dev/test
DEV_TEST_MODE=false

# Optional metrics protection for future implementation
METRICS_TOKEN=
