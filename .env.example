# Example environment variables for local development and Render deployment

# Required for core app functionality
API_KEY=your_tiktok_api_key
JWT_SECRET=your_strong_jwt_secret
DISK_PATH=/var/data

# Postmark email support for verification and password reset flows
POSTMARK_API_TOKEN=your_postmark_server_api_token
EMAIL_FROM="Battle Royale <no-reply@yourdomain.com>"
APP_BASE_URL=https://your-app.onrender.com

# PayPal integration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_PAYMENT_LINK=https://www.paypal.com
POSTMARK_TEST_EMAIL=your_test_email@example.com

# Optional render / production settings
NODE_ENV=production
LOG_LEVEL=info
SENTRY_DSN=
REDIS_URL=
ADMIN_PASSWORD=
CLAIM_JWT_SECRET=
DEV_TEST_MODE=false
