{
  "name": "tiktok-pvp-battle",
  "version": "1.0.0",
  "description": "TikTok LIVE PvP Battle Game",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "cross-env NODE_ENV=development node server.js",
    "audit:stability": "node scripts/stability_audit.js",
    "lint": "node scripts/stability_audit.js",
    "test:logic": "node scripts/business_logic_smoke.js",
    "test:marketing": "node scripts/marketing_logic_smoke.js",
    "test:http": "node scripts/http_smoke.js",
    "test:socket": "node scripts/socket_smoke.js",
    "test:e2e": "playwright test",
    "test:overlay:visual": "node scripts/overlay_visual_audit.js",
    "test:qa:contracts": "node scripts/qa_entitlement_contract.js",
    "test:qa:e2e": "playwright test tests/e2e/v1-qa.spec.js",
    "test:qa": "npm run test:qa:contracts && npm run test:qa:e2e",
    "test:e2e:install": "playwright install chromium",
    "test:postmark": "node scripts/test_postmark.js",
    "capture:overlay-v2": "node scripts/capture_overlay_v2_screenshots.js",
    "capture:overlay-demo-video": "node scripts/capture_overlay_demo_video.js",
    "test:all": "npm run validate:schemas && npm run audit:stability && npm run test:logic && npm run test:marketing && npm run test:http && npm run test:socket && npm run test:qa:contracts && npm run test:e2e",
    "launch:check": "node scripts/launch_readiness_check.js --strict",
    "launch:check:local": "node scripts/launch_readiness_check.js",
    "launch:check:remote": "node scripts/launch_readiness_check.js --strict --url https://intothebattle.com",
    "marketing:generate": "node scripts/generate_marketing_posts.js",
    "marketing:publish:dry-run": "node scripts/publish_marketing_posts.js",
    "marketing:publish": "node scripts/publish_marketing_posts.js --live",
    "video:studio": "remotion studio remotion/index.jsx --port=3002",
    "video:render:homepage": "remotion render remotion/index.jsx battle-homepage media/remotion/homepage-battle-demo.mp4 --codec=h264 --crf=20 --muted --overwrite",
    "video:render:growth": "remotion render remotion/index.jsx battle-growth-vertical media/remotion/growth-battle-demo-vertical.mp4 --codec=h264 --crf=20 --muted --overwrite",
    "video:render:all": "npm run video:render:homepage && npm run video:render:growth",
    "validate:schema": "python tools/validate_schema.py",
    "validate:schema-expand": "python tools/validate_schema_expand.py",
    "validate:schemas": "npm run validate:schema && npm run validate:schema-expand"
  },
  "dependencies": {
    "@hubspot/api-client": "^13.5.0",
    "@microsoft/clarity": "^1.0.2",
    "@segment/analytics-node": "^3.1.0",
    "@sentry/node": "^10.60.0",
    "@socket.io/redis-adapter": "^7.1.0",
    "@tiktool/live": "2.7.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "fingerprintjs2": "^2.1.0",
    "gsap": "^3.12.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.11.0",
    "phaser": "^4.2.0",
    "pino": "^8.13.0",
    "postmark": "^4.0.7",
    "prom-client": "^14.2.0",
    "redis": "^4.6.7",
    "socket.io": "^4.7.5",
    "three": "^0.150.0",
    "uuid": "^11.1.1",
    "zod": "4.3.6"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "@remotion/cli": "4.0.484",
    "cross-env": "^10.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484",
    "socket.io-client": "^4.7.5"
  }
}
