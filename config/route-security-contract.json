{
  "version": 1,
  "csrfEquivalent": {
    "sameOriginMutationGuard": true,
    "adminSameSiteCookie": "strict",
    "notes": "Admin form mutations rely on same-origin Origin/Referer enforcement plus Strict HttpOnly admin cookies. PayPal webhooks are exempt and must verify provider signatures."
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/dashboard",
      "category": "creator",
      "access": "dashboard-session",
      "unauthenticated": 302,
      "production": "enabled"
    },
    {
      "method": "POST",
      "path": "/api/connect",
