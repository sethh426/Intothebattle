      "production": "enabled"
    },
    {
      "method": "POST",
      "path": "/api/stream/setup/start",
      "category": "creator-control",
      "access": "room-session",
      "unauthenticated": 401,
      "production": "enabled"
    },
    {
      "method": "POST",
      "path": "/api/stream/setup/reset",
      "category": "creator-control",
      "access": "room-session",
