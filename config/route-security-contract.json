    },
    {
      "method": "GET",
      "path": "/state",
      "category": "overlay-state",
      "access": "signed-room-overlay-token",
      "unauthenticated": 401,
      "production": "enabled"
    },
    {
      "method": "POST",
      "path": "/api/sponsor/upload",
