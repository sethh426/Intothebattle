APP_DOMAIN=intothebattle.com, www.intothebattle.com
ACME_EMAIL=support@intothebattle.com
APP_BASE_URL=https://intothebattle.com

POSTGRES_PASSWORD=replace_with_generated_postgres_password
JWT_SECRET=replace_with_generated_jwt_secret
OVERLAY_TOKEN_SECRET=replace_with_generated_overlay_secret
METRICS_TOKEN=replace_with_generated_metrics_token
DIAGNOSTICS_TOKEN=replace_with_generated_diagnostics_token

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DISK_PATH=/usr/src/app/data
TRUST_PROXY_HOPS=1
ENABLE_ROOM_SCOPED=true
ENABLE_REDIS_ADAPTER=false
PRODUCTION_INSTANCE_COUNT=1
LOG_LEVEL=info

# TikTok LIVE uses the legacy direct connector. The unfinished official OAuth
# integration is intentionally disabled and hidden from streamer-facing UI.
API_KEY=
TIKTOK_LIVE_MODE=direct
TIKTOK_AUTO_RECONNECT=true
TIKTOK_MAX_RECONNECT_ATTEMPTS=3
TIKTOK_HEARTBEAT_MS=10000
TIKTOK_LIVE_EVENT_PROVIDER=legacy
TIKTOK_REQUIRE_ACCOUNT_LINK_FOR_LIVE=false

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_PAYMENT_LINK=
PAYPAL_CURRENCY=USD

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://intothebattle.com/auth/google/callback

POSTMARK_API_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
EMAIL_FROM="IntoTheBattle <no-reply@intothebattle.com>"
EMAIL_REPLY_TO=support@intothebattle.com
SUPPORT_EMAIL=support@intothebattle.com

MARKETING_PLATFORMS=tiktok
MARKETING_AUTOMATION_ENABLED=false
MARKETING_AUTO_POST_ENABLED=false
MARKETING_DRY_RUN=true
MARKETING_OUTBOUND_WEBHOOK_URL=
GROWTH_TRACKING_ENABLED=false
GROWTH_API_SYNC_ENABLED=false
HUBSPOT_PRIVATE_APP_TOKEN=
SEGMENT_WRITE_KEY=
SEGMENT_BROWSER_WRITE_KEY=

ADMIN_PASSWORD=
SENTRY_DSN=
CLARITY_PROJECT_ID=
ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_EMAIL=
INCIDENT_RUNBOOK_URL=
BACKUP_RESTORE_VERIFIED_AT=
BACKUP_RESTORE_MAX_AGE_DAYS=30

DEV_TEST_MODE=false
